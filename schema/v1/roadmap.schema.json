{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectchronicle.dev/schema/v1/roadmap.schema.json",
  "title": "RoadmapRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "items"],
  "properties": {
    "schema_version": { "$ref": "./common.schema.json#/$defs/schemaVersion" },
    "updated_at": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/roadmapItem" }
    }
  },
  "$defs": {
    "roadmapItem": {
      "oneOf": [
        { "$ref": "#/$defs/standardItem" },
        { "$ref": "#/$defs/blockedItem" },
        { "$ref": "#/$defs/supersededItem" }
      ]
    },
    "standardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "order"],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/roadmapId" },
        "title": { "$ref": "./common.schema.json#/$defs/singleLine" },
        "status": { "enum": ["pending", "active", "completed", "abandoned"] },
        "order": { "type": "integer" },
        "parent_id": { "$ref": "./common.schema.json#/$defs/roadmapId" },
        "follows": { "$ref": "./common.schema.json#/$defs/typedReference" },
        "branch_id": { "$ref": "./common.schema.json#/$defs/branchId" },
        "acceptance_criteria": { "$ref": "#/$defs/roadmapStringArray" },
        "related_milestones": { "$ref": "#/$defs/roadmapMilestoneIdArray" },
        "blocker_summary": { "$ref": "./common.schema.json#/$defs/nonEmptyString" },
        "blocked_by": { "$ref": "#/$defs/roadmapBlockerArray" },
        "planned_for": { "$ref": "./common.schema.json#/$defs/date" }
      }
    },
    "blockedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "order", "blocker_summary"],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/roadmapId" },
        "title": { "$ref": "./common.schema.json#/$defs/singleLine" },
        "status": { "const": "blocked" },
        "order": { "type": "integer" },
        "parent_id": { "$ref": "./common.schema.json#/$defs/roadmapId" },
        "follows": { "$ref": "./common.schema.json#/$defs/typedReference" },
        "branch_id": { "$ref": "./common.schema.json#/$defs/branchId" },
        "acceptance_criteria": { "$ref": "#/$defs/roadmapStringArray" },
        "related_milestones": { "$ref": "#/$defs/roadmapMilestoneIdArray" },
        "blocker_summary": { "$ref": "./common.schema.json#/$defs/nonEmptyString" },
        "blocked_by": { "$ref": "#/$defs/roadmapBlockerArray" },
        "planned_for": { "$ref": "./common.schema.json#/$defs/date" }
      }
    },
    "supersededItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "order", "superseded_by"],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/roadmapId" },
        "title": { "$ref": "./common.schema.json#/$defs/singleLine" },
        "status": { "const": "superseded" },
        "order": { "type": "integer" },
        "parent_id": { "$ref": "./common.schema.json#/$defs/roadmapId" },
        "follows": { "$ref": "./common.schema.json#/$defs/typedReference" },
        "branch_id": { "$ref": "./common.schema.json#/$defs/branchId" },
        "acceptance_criteria": { "$ref": "#/$defs/roadmapStringArray" },
        "related_milestones": { "$ref": "#/$defs/roadmapMilestoneIdArray" },
        "blocker_summary": { "$ref": "./common.schema.json#/$defs/nonEmptyString" },
        "blocked_by": { "$ref": "#/$defs/roadmapBlockerArray" },
        "superseded_by": { "$ref": "./common.schema.json#/$defs/roadmapId" },
        "planned_for": { "$ref": "./common.schema.json#/$defs/date" }
      }
    },
    "roadmapStringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "roadmapMilestoneIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "./common.schema.json#/$defs/milestoneId" }
    },
    "roadmapBlockerArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./common.schema.json#/$defs/typedReference" }
    }
  }
}
