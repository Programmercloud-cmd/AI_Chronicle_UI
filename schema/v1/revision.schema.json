{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectchronicle.dev/schema/v1/revision.schema.json",
  "title": "RevisionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "target", "recorded_at", "previous_revision", "reason", "summary", "changes"],
  "properties": {
    "schema_version": { "$ref": "./common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "./common.schema.json#/$defs/revisionId" },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/branchTarget" },
        { "$ref": "#/$defs/milestoneTarget" },
        { "$ref": "#/$defs/engineeringEventTarget" }
      ]
    },
    "recorded_at": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "previous_revision": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "./common.schema.json#/$defs/revisionId" }
      ]
    },
    "reason": { "enum": ["clerical_correction", "clarification", "late_attachment"] },
    "summary": { "type": "string" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/addChange" },
          { "$ref": "#/$defs/replaceChange" },
          { "$ref": "#/$defs/removeChange" }
        ]
      }
    }
  },
  "$defs": {
    "branchTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "branch" },
        "id": { "$ref": "./common.schema.json#/$defs/branchId" }
      }
    },
    "milestoneTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "milestone" },
        "id": { "$ref": "./common.schema.json#/$defs/milestoneId" }
      }
    },
    "engineeringEventTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "engineering_event" },
        "id": { "$ref": "./common.schema.json#/$defs/engineeringEventId" }
      }
    },
    "addChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "value"],
      "properties": {
        "operation": { "const": "add" },
        "path": { "$ref": "./common.schema.json#/$defs/jsonPointer" },
        "value": {}
      }
    },
    "replaceChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "from", "value"],
      "properties": {
        "operation": { "const": "replace" },
        "path": { "$ref": "./common.schema.json#/$defs/jsonPointer" },
        "from": {},
        "value": {}
      }
    },
    "removeChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "from"],
      "properties": {
        "operation": { "const": "remove" },
        "path": { "$ref": "./common.schema.json#/$defs/jsonPointer" },
        "from": {}
      }
    }
  }
}
