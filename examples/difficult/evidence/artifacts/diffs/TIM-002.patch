+@dataclass(frozen=True)
+class ClockModel:
+    offsets: Mapping[str, float]
+
+    def normalize(self, source: str, timestamp: float) -> float:
+        if source not in self.offsets:
+            raise TimestampQueueError(f"unknown clock source: {source}")
+        offset = self.offsets[source]
+        if not isfinite(timestamp) or not isfinite(offset):
+            raise TimestampQueueError("timestamp and offset must be finite")
+        return timestamp + offset
 
 
