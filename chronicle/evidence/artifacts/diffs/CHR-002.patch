+      if (gestureRef.current === undefined) latestCameraRef.current = { ...camera };
+      return;
+    }
+
+    const gesture = gestureRef.current;
+    if (
+      !environmentChanged &&
+      gesture?.active === true &&
+      gesture.requestedCameraKeys.has(incomingCameraKey)
+    ) {
+      return;
+    }
