+      logicalPoint,
+      projection,
+      latestCameraRef.current,
+      viewport,
+      navigationBounds,
+    );
+    if (requestedCamera !== undefined) {
+      latestCameraRef.current = requestedCamera;
+      callback(requestedCamera);
+    }
+  }
+
+  return (
+    <svg
+      className={classes}
+      viewBox={`0 0 ${MINIMAP_LOGICAL_WIDTH} ${MINIMAP_LOGICAL_HEIGHT}`}
+      width="100%"
+      height="100%"
