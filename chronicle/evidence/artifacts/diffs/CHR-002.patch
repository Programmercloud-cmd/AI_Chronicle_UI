+      elementRect.width / MINIMAP_LOGICAL_WIDTH,
+      elementRect.height / MINIMAP_LOGICAL_HEIGHT,
+    );
+    if (!Number.isFinite(clientToLogicalScale) || clientToLogicalScale <= 0) return;
