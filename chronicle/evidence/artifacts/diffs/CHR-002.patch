+          return (
+            <line
+              key={edge.id}
+              data-edge-id={edge.id}
+              data-edge-kind={edge.kind}
+              className={`history-minimap-edge ${branchClass(ordinal)} history-edge-${edge.kind}`}
+              x1={from.x}
+              y1={from.y}
+              x2={to.x}
+              y2={to.y}
