+    const wrongBranch = cloneJson(await load("canonical"));
+    wrongBranch.roadmap.value.items.find((item) => item.id === "RM-003")!.branch_id = "BR-MAIN";
+    await expectCode(wrongBranch, "projection-branch-mismatch");
