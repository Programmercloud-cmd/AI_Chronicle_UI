+      "evidence/records/EVD-0001.yaml",
+    );
+
+    expect(result.ok).toBe(true);
+    if (!result.ok) return;
+    expect(result.value.bytes.toString("utf8")).toBe("pass");
+    expect(result.value.size).toBe(4);
