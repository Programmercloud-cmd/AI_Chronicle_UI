diff --git a/src/server/security.ts b/src/server/security.ts
new file mode 100644
index 0000000000000000000000000000000000000000..65abd1df015077daa1a666438bf50ffe4f3d85a0
--- /dev/null
+++ b/src/server/security.ts
@@ -0,0 +1,60 @@
+import path from "node:path";
+
+export const CONTENT_SECURITY_POLICY = [
+  "default-src 'none'",
+  "img-src 'self'",
+  "style-src 'none'",
+  "script-src 'none'",
+  "connect-src 'self'",
+  "base-uri 'none'",
+  "form-action 'none'",
+  "frame-ancestors 'none'",
+  "sandbox",
+].join("; ");
+
+export const APPLICATION_CONTENT_SECURITY_POLICY = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self'",
+  "connect-src 'self'",
+  "font-src 'self'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'none'",
+  "frame-ancestors 'none'",
+].join("; ");
+
+export function escapeHtml(value: string): string {
+  return value.replace(/[&<>"']/gu, (character) => ({
+    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
+  })[character]!);
+}
+
+export function safeAttachmentFilename(locator: string): string {
+  const basename = path.posix.basename(locator);
+  const safe = basename.replace(/[^A-Za-z0-9._-]/gu, "_").replace(/^\.+/u, "");
+  return safe.length > 0 ? safe : "chronicle-evidence.bin";
+}
+
+export function contentDisposition(disposition: "attachment" | "inline", locator: string): string {
+  return `${disposition}; filename="${safeAttachmentFilename(locator)}"`;
+}
+
+export function imageMediaType(bytes: Buffer, declared: string): "image/png" | "image/jpeg" | "image/webp" | undefined {
+  if (declared === "image/png" && bytes.length >= 8 &&
+      bytes.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) return "image/png";
+  if (declared === "image/jpeg" && bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return "image/jpeg";
+  if (declared === "image/webp" && bytes.length >= 12 &&
+      bytes.subarray(0, 4).toString("ascii") === "RIFF" && bytes.subarray(8, 12).toString("ascii") === "WEBP") return "image/webp";
+  return undefined;
+}
+
+export function decodePreviewText(bytes: Buffer, declared: string): string | undefined {
+  if (declared !== "text/plain" && declared !== "text/x-diff") return undefined;
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+  } catch {
+    return undefined;
+  }
+}
diff --git a/src/server/server.ts b/src/server/server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8ef35e1934921851eef83da6e6e70804fbcab802
--- /dev/null
+++ b/src/server/server.ts
@@ -0,0 +1,137 @@
+import { createHash } from "node:crypto";
+
+import Fastify, { type FastifyInstance, type FastifyReply } from "fastify";
+
+import { loadChronicle, readContainedArtifact } from "../data";
+import { validateChronicle, type ValidatedChronicle } from "../domain";
+import type { EvidenceRecord } from "../schema";
+import { projectHttpDiagnostics } from "./http-diagnostics";
+import {
+  APPLICATION_CONTENT_SECURITY_POLICY,
+  CONTENT_SECURITY_POLICY,
+  contentDisposition,
+  decodePreviewText,
+  escapeHtml,
+  imageMediaType,
+} from "./security";
+import { registerWebUi, resolveDefaultWebRoot } from "./static-web";
+
+export const DEFAULT_PORT = 4317;
+export const LOOPBACK_HOST = "127.0.0.1";
+
+interface EvidenceContext {
+  snapshot: ValidatedChronicle;
+  evidence: { sourcePath: string; value: EvidenceRecord };
+  bytes: Buffer;
+}
+
+type ContextResult<T> = { ok: true; value: T } | { ok: false; statusCode: number; body: unknown };
+
+async function validatedSnapshot(rootPath: string): Promise<ContextResult<ValidatedChronicle>> {
+  const loaded = await loadChronicle(rootPath);
+  if (!loaded.ok) return { ok: false, statusCode: 422, body: { error: "chronicle-invalid", diagnostics: projectHttpDiagnostics(loaded.diagnostics) } };
+  const validated = await validateChronicle(loaded.value);
+  if (!validated.ok) return { ok: false, statusCode: 422, body: { error: "chronicle-invalid", diagnostics: projectHttpDiagnostics(validated.diagnostics) } };
+  return { ok: true, value: validated.value };
+}
+
+async function evidenceContext(rootPath: string, id: string): Promise<ContextResult<EvidenceContext>> {
+  const validated = await validatedSnapshot(rootPath);
+  if (!validated.ok) return validated;
+  const evidence = validated.value.evidence.find((record) => record.value.id === id);
+  if (evidence === undefined || evidence.value.source.kind !== "artifact") {
+    return { ok: false, statusCode: 404, body: { error: "artifact-evidence-not-found" } };
+  }
+  const read = await readContainedArtifact(
+    { inputPath: validated.value.rootPath, realPath: validated.value.rootPath },
+    evidence.value.source.path,
+    evidence.sourcePath,
+  );
+  if (!read.ok) return { ok: false, statusCode: 422, body: { error: "artifact-unavailable", diagnostics: projectHttpDiagnostics(read.diagnostics) } };
+  const digest = createHash("sha256").update(read.value.bytes).digest("hex");
+  if (digest !== evidence.value.source.sha256) {
+    return { ok: false, statusCode: 422, body: { error: "artifact-hash-mismatch" } };
+  }
+  return { ok: true, value: { snapshot: validated.value, evidence, bytes: read.value.bytes } };
+}
+
+function sendFailure(reply: FastifyReply, result: { statusCode: number; body: unknown }): FastifyReply {
+  return reply.code(result.statusCode).type("application/json; charset=utf-8").send(result.body);
+}
+
+export interface CreateServerOptions { webRoot?: string }
+
+export function createChronicleServer(rootPath: string, options: CreateServerOptions = {}): FastifyInstance {
+  const server = Fastify({ logger: false, bodyLimit: 1024 });
+  server.addHook("onRequest", async (request, reply) => {
+    const pathname = request.url.split("?", 1)[0] ?? "/";
+    const apiRequest = pathname === "/api" || pathname.startsWith("/api/");
+    const applicationRequest = options.webRoot !== undefined && !apiRequest;
+    reply.header("Content-Security-Policy", applicationRequest
+      ? APPLICATION_CONTENT_SECURITY_POLICY
+      : CONTENT_SECURITY_POLICY);
+    reply.header("X-Content-Type-Options", "nosniff");
+    reply.header("X-Frame-Options", "DENY");
+    reply.header("Referrer-Policy", "no-referrer");
+    reply.header("Cache-Control", "no-store");
+  });
+  server.setErrorHandler(async (_error, _request, reply) =>
+    reply.code(500).type("application/json; charset=utf-8").send({ error: "internal-server-error" }));
+
+  server.get("/api/snapshot", async (_request, reply) => {
+    const result = await validatedSnapshot(rootPath);
+    if (!result.ok) return sendFailure(reply, result);
+    const { rootPath: _internalRootPath, ...publicSnapshot } = result.value;
+    return reply.type("application/json; charset=utf-8").send(publicSnapshot);
+  });
+
+  server.get<{ Params: { id: string } }>("/api/evidence/:id/preview", async (request, reply) => {
+    const result = await evidenceContext(rootPath, request.params.id);
+    if (!result.ok) return sendFailure(reply, result);
+    const { evidence, bytes } = result.value;
+    if (evidence.value.source.kind !== "artifact") return reply.code(404).send({ error: "artifact-evidence-not-found" });
+
+    const text = decodePreviewText(bytes, evidence.value.source.media_type);
+    if (text !== undefined) {
+      const html = `<!doctype html><html><head><meta charset="utf-8"><title>${escapeHtml(evidence.value.title)}</title></head><body><pre>${escapeHtml(text)}</pre></body></html>`;
+      return reply.type("text/html; charset=utf-8").send(html);
+    }
+    const imageType = imageMediaType(bytes, evidence.value.source.media_type);
+    if (imageType !== undefined) {
+      reply.header("Content-Disposition", contentDisposition("inline", evidence.value.source.path));
+      return reply.type(imageType).send(bytes);
+    }
+    return reply.code(415).type("application/json; charset=utf-8").send({
+      error: "preview-unavailable",
+      message: "This artifact is download-only.",
+      raw_url: `/api/evidence/${encodeURIComponent(evidence.value.id)}/raw`,
+    });
+  });
+
+  server.get<{ Params: { id: string } }>("/api/evidence/:id/raw", async (request, reply) => {
+    const result = await evidenceContext(rootPath, request.params.id);
+    if (!result.ok) return sendFailure(reply, result);
+    const { evidence, bytes } = result.value;
+    if (evidence.value.source.kind !== "artifact") return reply.code(404).send({ error: "artifact-evidence-not-found" });
+    reply.header("Content-Disposition", contentDisposition("attachment", evidence.value.source.path));
+    return reply.type("application/octet-stream").send(bytes);
+  });
+
+  if (options.webRoot !== undefined) registerWebUi(server, options.webRoot);
+
+  return server;
+}
+
+export interface StartServerOptions { port?: number; host?: string }
+
+export async function startChronicleServer(rootPath: string, options: StartServerOptions = {}): Promise<FastifyInstance> {
+  const host = options.host ?? LOOPBACK_HOST;
+  if (host !== LOOPBACK_HOST) throw new Error(`Chronicle only binds ${LOOPBACK_HOST}`);
+  const port = options.port ?? DEFAULT_PORT;
+  if (!Number.isInteger(port) || port < 0 || port > 65535) throw new Error("port must be an integer from 0 through 65535");
+  const preflight = await validatedSnapshot(rootPath);
+  if (!preflight.ok) throw new Error("Chronicle dataset is invalid and cannot be served");
+  const server = createChronicleServer(rootPath, { webRoot: resolveDefaultWebRoot() });
+  await server.listen({ host: LOOPBACK_HOST, port });
+  return server;
+}
diff --git a/src/server/static-web.ts b/src/server/static-web.ts
new file mode 100644
index 0000000000000000000000000000000000000000..98a5ef9d1574d745839d5f4c8058f2eb4eaf68b8
--- /dev/null
+++ b/src/server/static-web.ts
@@ -0,0 +1,63 @@
+import { statSync } from "node:fs";
+import path from "node:path";
+
+import fastifyStatic from "@fastify/static";
+import type { FastifyInstance, FastifyReply, FastifyRequest } from "fastify";
+
+export function assertWebRoot(webRoot: string): string {
+  const resolved = path.resolve(webRoot);
+  try {
+    if (!statSync(resolved).isDirectory() || !statSync(path.join(resolved, "index.html")).isFile()) {
+      throw new Error("invalid web root");
+    }
+  } catch {
+    throw new Error("Chronicle web assets are unavailable; rebuild or reinstall Chronicle.");
+  }
+  return resolved;
+}
+
+export function resolveDefaultWebRoot(moduleDirectory = __dirname): string {
+  const candidates = [
+    path.resolve(moduleDirectory, "../../web"),
+    path.resolve(moduleDirectory, "../../dist/web"),
+  ];
+  for (const candidate of candidates) {
+    try {
+      return assertWebRoot(candidate);
+    } catch {
+      // Source execution and compiled package execution have different module roots.
+    }
+  }
+  throw new Error("Chronicle web assets are unavailable; rebuild or reinstall Chronicle.");
+}
+
+function requestPath(request: FastifyRequest): string {
+  return request.url.split("?", 1)[0] ?? "/";
+}
+
+function isSpaNavigation(request: FastifyRequest): boolean {
+  if (request.method !== "GET" && request.method !== "HEAD") return false;
+  const pathname = requestPath(request);
+  return pathname !== "/api" &&
+    !pathname.startsWith("/api/") &&
+    pathname !== "/assets" &&
+    !pathname.startsWith("/assets/") &&
+    path.posix.extname(pathname) === "";
+}
+
+export function registerWebUi(server: FastifyInstance, webRoot: string): void {
+  const root = assertWebRoot(webRoot);
+  server.register(fastifyStatic, {
+    root,
+    prefix: "/",
+    wildcard: false,
+    index: false,
+    cacheControl: false,
+  });
+  server.setNotFoundHandler(async (request, reply: FastifyReply) => {
+    if (isSpaNavigation(request)) {
+      return reply.type("text/html; charset=utf-8").sendFile("index.html");
+    }
+    return reply.code(404).type("application/json; charset=utf-8").send({ error: "not-found" });
+  });
+}
diff --git a/src/timeline/calendar.ts b/src/timeline/calendar.ts
new file mode 100644
index 0000000000000000000000000000000000000000..023642d5ca7dc5d01ce5cbbadfdf41fc726fc9da
--- /dev/null
+++ b/src/timeline/calendar.ts
@@ -0,0 +1,124 @@
+import type { TimelineCalendar } from "./types";
+
+interface LocalParts {
+  year: number;
+  month: number;
+  day: number;
+  hour: number;
+  minute: number;
+  second: number;
+}
+
+const formatterCache = new Map<string, Intl.DateTimeFormat>();
+
+function formatter(timeZone: string): Intl.DateTimeFormat {
+  const cached = formatterCache.get(timeZone);
+  if (cached !== undefined) return cached;
+  const created = new Intl.DateTimeFormat("en-CA", {
+    timeZone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+    second: "2-digit",
+    hourCycle: "h23",
+  });
+  formatterCache.set(timeZone, created);
+  return created;
+}
+
+function partsAt(epochMs: number, timeZone: string): LocalParts {
+  const values: Record<string, string> = {};
+  for (const part of formatter(timeZone).formatToParts(new Date(epochMs))) {
+    if (part.type !== "literal") values[part.type] = part.value;
+  }
+  const result = {
+    year: Number(values.year),
+    month: Number(values.month),
+    day: Number(values.day),
+    hour: Number(values.hour),
+    minute: Number(values.minute),
+    second: Number(values.second),
+  };
+  if (Object.values(result).some((value) => !Number.isInteger(value))) {
+    throw new Error(`cannot resolve local date parts in timezone ${timeZone}`);
+  }
+  return result;
+}
+
+function pseudoUtc(parts: LocalParts): number {
+  return Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute, parts.second);
+}
+
+function localDateTimeEpochMs(parts: LocalParts, timeZone: string): number {
+  const target = pseudoUtc(parts);
+  let guess = target;
+  for (let attempt = 0; attempt < 8; attempt += 1) {
+    const observed = partsAt(guess, timeZone);
+    const delta = target - pseudoUtc(observed);
+    if (delta === 0) return guess;
+    guess += delta;
+  }
+  throw new Error(
+    `local time ${parts.year}-${String(parts.month).padStart(2, "0")}-${String(parts.day).padStart(2, "0")} ` +
+      `${String(parts.hour).padStart(2, "0")}:${String(parts.minute).padStart(2, "0")}:${String(parts.second).padStart(2, "0")} ` +
+      `does not resolve in timezone ${timeZone}`,
+  );
+}
+
+function parseMonthKey(monthKey: string): { year: number; month: number } {
+  const match = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(monthKey);
+  if (match === null) throw new Error(`invalid month key ${monthKey}`);
+  return { year: Number(match[1]), month: Number(match[2]) };
+}
+
+function parseDate(date: string): { year: number; month: number; day: number } {
+  const match = /^(\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/.exec(date);
+  if (match === null) throw new Error(`invalid planned date ${date}`);
+  const result = { year: Number(match[1]), month: Number(match[2]), day: Number(match[3]) };
+  const normalized = new Date(Date.UTC(result.year, result.month - 1, result.day));
+  if (
+    normalized.getUTCFullYear() !== result.year ||
+    normalized.getUTCMonth() !== result.month - 1 ||
+    normalized.getUTCDate() !== result.day
+  ) {
+    throw new Error(`planned date ${date} does not resolve`);
+  }
+  return result;
+}
+
+export const defaultTimelineCalendar: TimelineCalendar = {
+  monthKeyForInstant(epochMs, timeZone) {
+    const parts = partsAt(epochMs, timeZone);
+    return `${String(parts.year).padStart(4, "0")}-${String(parts.month).padStart(2, "0")}`;
+  },
+
+  monthStartEpochMs(monthKey, timeZone) {
+    const { year, month } = parseMonthKey(monthKey);
+    return localDateTimeEpochMs({ year, month, day: 1, hour: 0, minute: 0, second: 0 }, timeZone);
+  },
+
+  nextMonthKey(monthKey) {
+    const { year, month } = parseMonthKey(monthKey);
+    const nextYear = month === 12 ? year + 1 : year;
+    const nextMonth = month === 12 ? 1 : month + 1;
+    return `${String(nextYear).padStart(4, "0")}-${String(nextMonth).padStart(2, "0")}`;
+  },
+
+  localNoonEpochMs(date, timeZone) {
+    const { year, month, day } = parseDate(date);
+    return localDateTimeEpochMs({ year, month, day, hour: 12, minute: 0, second: 0 }, timeZone);
+  },
+
+  formatMonth(monthKey) {
+    const { year, month } = parseMonthKey(monthKey);
+    return new Intl.DateTimeFormat("en-US", {
+      timeZone: "UTC",
+      month: "long",
+      year: "numeric",
+    })
+      .format(new Date(Date.UTC(year, month - 1, 1)))
+      .toUpperCase();
+  },
+};
diff --git a/src/timeline/index.ts b/src/timeline/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b94a85f314446838d069b26d06469e0382ae3233
--- /dev/null
+++ b/src/timeline/index.ts
