diff --git a/examples/canonical/evidence/artifacts/sample-base/src/timestamp_queue.py b/examples/canonical/evidence/artifacts/sample-base/src/timestamp_queue.py
new file mode 100644
index 0000000000000000000000000000000000000000..5a99b8d94954508b2c0f5a325129c4dfec1654df
--- /dev/null
+++ b/examples/canonical/evidence/artifacts/sample-base/src/timestamp_queue.py
@@ -0,0 +1,19 @@
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Sample:
+    source_timestamp: float
+    payload: bytes
+
+
+class TimestampQueue:
+    def __init__(self) -> None:
+        self._items: list[Sample] = []
+
+    def push(self, sample: Sample) -> None:
+        self._items.append(sample)
+        self._items.sort(key=lambda item: item.source_timestamp)
+
+    def pop(self) -> Sample:
+        return self._items.pop(0)
