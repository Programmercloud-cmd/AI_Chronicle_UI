+    "summary": { "type": "string" },
+    "changes": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "oneOf": [
+          { "$ref": "#/$defs/addChange" },
+          { "$ref": "#/$defs/replaceChange" },
+          { "$ref": "#/$defs/removeChange" }
+        ]
+      }
