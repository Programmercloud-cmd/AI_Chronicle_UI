{
  "name": "project-chronicle",
  "version": "0.1.0",
  "private": true,
  "description": "Portable local development-history visualization",
  "files": [
    "dist/",
    "templates/chronicle/AGENTS.md",
    "README.md",
    "docs/schema/v1-public-contract.md",
    "docs/usability/orientation-study.md"
  ],
  "bin": {
    "chronicle": "dist/src/cli/bin.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "chronicle": "node dist/src/cli/bin.js",
    "dev:web": "vite",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "test:visual": "node scripts/history-visual.mjs",
    "release:check": "npm run check && npm run test:visual && npm run test:package",
    "schema:generate": "node scripts/schema-types.mjs --write",
    "schema:check": "node scripts/schema-types.mjs --check",
    "check": "npm run schema:check && npm run build && npm test"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.11.3",
    "react": "^19.2.8",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
